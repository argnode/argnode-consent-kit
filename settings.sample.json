{
  "loader": {
    "mode": "gtm",
    "gtmId": "GTM-XXXXXXX",
    "gtagId": "G-XXXXXXXXXX",
    "gtmDataLayerName": "dataLayer"
  },
  "consentMode": {
    "waitForUpdate": 500,
    "urlPassthrough": true,
    "adsDataRedaction": true
  },
  "language": {
    "source": "html",
    "fixed": null,
    "fallback": "en"
  },
  "storage": {
    "cookieName": "ack_consent",
    "maxAgeDays": 365,
    "domain": "auto",
    "path": "/",
    "sameSite": "Lax"
  },
  "identity": {
    "enabled": false,
    "cookieName": "ack_uid",
    "maxAgeDays": 365,
    "category": "statistic",
    "dataLayerKey": "user_id",
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
  },
  "banner": {
    "attribution": "text",
    "attributionLogo": "on-light",
    "poweredByText": "Powered by argnode",
    "poweredByUrl": null,
    "policyUrl": {
      "en": "/cookie-policy",
      "fi": "/evastekaytanto"
    }
  },
  "bots": {
    "skip": true,
    "pattern": null
  },
  "customCss": false,
  "customTexts": []
}
